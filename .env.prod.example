# Production Environment Configuration
# Copy this to .env.prod and fill in real values

# ═══════════════════════════════════════════════════════
# KOYEB (Backend + PostgreSQL)
# ═══════════════════════════════════════════════════════
# Get these from: app.koyeb.com → Your Service → Settings

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL (from Koyeb database dashboard)
DB_HOST=<koyeb-db-host>.koyeb.app
DB_PORT=5432
DB_NAME=nadi
DB_USERNAME=<koyeb-db-username>
DB_PASSWORD=<koyeb-db-password>

# JWT (generate a strong secret, min 32 chars)
JWT_SECRET=<generate-random-64-char-string>

# Firebase (optional)
FIREBASE_ENABLED=false

# ═══════════════════════════════════════════════════════
# VERCEL (Frontend)
# ═══════════════════════════════════════════════════════
# Set these in: vercel.com → Project → Settings → Environment Variables

# Backend API URL (the Koyeb service URL)
VITE_API_URL=https://<your-app>.koyeb.app/api

# ═══════════════════════════════════════════════════════
# GITHUB ACTIONS CI/CD
# ═══════════════════════════════════════════════════════
# Set these in: github.com/ton-repo/settings/secrets/actions

# Vercel
VERCEL_TOKEN=<your-vercel-token>
VERCEL_ORG_ID=<your-org-id>
VERCEL_PROJECT_ID=<your-project-id>

# Koyeb
KOYEB_API_KEY=<your-koyeb-api-key>
KOYEB_SERVICE_ID=<your-service-id>
KOYEB_BACKEND_URL=https://<your-app>.koyeb.app
